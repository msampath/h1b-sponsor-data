# Copy to .env and fill in the blanks. .env is gitignored.

# Local Postgres holding the raw DOL disclosures: lca_disclosure,
# pwd_disclosure, perm_disclosure. etl/build.py reads these and writes the
# curated `sponsors` schema into the same database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
SOURCE_DB=lca

# R2. Dashboard -> R2 Object Storage -> Overview -> API -> Manage API tokens.
# Create a token with Object Read & Write. That page is R2 specific and is not
# the account-wide API tokens page under My Profile.
# etl/publish.py builds the S3 endpoint from R2_ACCOUNT_ID, so the endpoint URL
# the dashboard shows is not needed here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=h1b-sponsor-data
